BEGIN_MODEL FACEGEOM

/* Every face gets a node of its own, on both sides, so each node names
   exactly one face and the expected table beside this file can give that
   face's area and position.  Sizes are order 1 so six decimals leave plenty
   of margin, and the meshes are uneven so that swapping the two parametric
   directions moves the numbers. */

BULK Alu;
Alu = [2700.00000000, 900.00000000, 150.00000000];

OPTICAL Black;
Black = [0.90000000, 0.10000000, 0.00000000, 0.90000000, 0.10000000, 0.00000000,
    0.00000000, 0.00000000];

GEOMETRY TRAP;
TRAP = SHELL_SCS_TRAPEZOID(
    beta_min = 1.00000000,
    beta_max = 3.00000000,
    gamma_min = 60.00000000,
    gamma_max = 120.00000000,
    height = 0.50000000,
    nodes1 = 3,
    nodes2 = 2,
    nbase1 = 1000,
    ndelta1 = 1,
    nbase2 = 1500,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

GEOMETRY QUAD;
QUAD = SHELL_QUADRILATERAL(
    point1 = [5.00000000, 0.00000000, 0.00000000],
    point2 = [7.00000000, 0.00000000, 0.00000000],
    point3 = [6.50000000, 2.00000000, 0.00000000],
    point4 = [5.50000000, 2.00000000, 0.00000000],
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 2000,
    ndelta1 = 1,
    nbase2 = 2500,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

GEOMETRY RECT;
RECT = SHELL_SCS_RECTANGLE(
    xmin = 0.00000000,
    xmax = 2.00000000,
    ymin = 0.00000000,
    ymax = 1.00000000,
    height = -1.00000000,
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 3000,
    ndelta1 = 1,
    nbase2 = 3500,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

GEOMETRY TRI;
TRI = SHELL_TRIANGLE(
    point1 = [0.00000000, 5.00000000, 0.00000000],
    point2 = [2.00000000, 5.00000000, 0.00000000],
    point3 = [0.00000000, 8.00000000, 0.00000000],
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 4000,
    ndelta1 = 1,
    nbase2 = 4500,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

GEOMETRY DISC;
DISC = SHELL_SCS_DISC(
    rmin = 0.20000000,
    rmax = 1.00000000,
    angmin = 0.00000000,
    angmax = 90.00000000,
    height = 3.00000000,
    nodes1 = 2,
    nodes2 = 3,
    nbase1 = 5000,
    ndelta1 = 1,
    nbase2 = 5500,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

FACEGEOM = TRAP + QUAD + RECT + TRI + DISC;

END_MODEL
