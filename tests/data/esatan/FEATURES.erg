BEGIN_MODEL FEATURES

/* ------------------------------------------------------------------ */
/* Independent variables: declarations, expressions, vectors, points.  */
/* ------------------------------------------------------------------ */

CONST REAL FULL_TURN = 360.00000000;

REAL RADIUS = 0.10000000;
REAL HALF;
HALF = RADIUS / 2.00000000;
REAL SEMI = 30.00000000;
REAL SLOPE;
SLOPE = TAN(SEMI);
REAL SPAN;
SPAN = SQRT(RADIUS * RADIUS + HALF * HALF);
INTEGER NRING = 3;
INTEGER NSECT = 4;

REAL CUTS[3] =
{0.25000000, 0.50000000, 0.75000000};

POINT PO;
PO = [0.00000000, 0.00000000, 0.00000000];
POINT PX;
PX = [0.20000000, 0.00000000, 0.00000000];
POINT PY;
PY = [0.00000000, 0.20000000, 0.00000000];
POINT PZ;
PZ = [0.00000000, 0.00000000, 0.20000000];

/* ------------------------------------------------------------------ */
/* Materials.                                                          */
/* ------------------------------------------------------------------ */

OPTICAL Black;
Black       = [0.90, 0.10, 0.00, 0.90, 0.10, 0.00, 0.00, 0.00];
Black [BOL] = [0.85, 0.15, 0.00, 0.86, 0.14, 0.00, 0.00, 0.00];
Black [EOL] = [0.92, 0.08, 0.00, 0.94, 0.06, 0.00, 0.00, 0.00];

OPTICAL Mirror;
DEFINE_OPTICAL (
    optical = Mirror,
    ir_emiss = 0.05000000,
    ir_transm = 0.00000000,
    solar_absorb = 0.12000000,
    solar_transm = 0.00000000,
    ir_spec_refl = 0.90000000,
    solar_spec_refl = 0.85000000);

BULK Alu;
Alu = [2700.00000000, 900.00000000, 160.00000000];

BULK Steel;
DEFINE_BULK (
    bulk = Steel,
    density = 7900.00000000,
    sp_heat = 500.00000000,
    type = "Isotropic",
    cond = 15.00000000);

BULK Laminate;
DEFINE_BULK (
    bulk = Laminate,
    density = 1600.00000000,
    sp_heat = 1100.00000000,
    type = "Orthotropic",
    cond1 = 40.00000000,
    cond2 = 4.00000000,
    cond3 = 0.40000000);

INSULATION Blanket;
Blanket = DEFINE_INSULATION(
    optical = Black,
    layers = {DEFINE_LAYER(
        node_offset = 500000,
        submodel_name = "MLI",
        thickness = 0.01000000,
        bulk = Steel,
        through_cond = "BULK",
        emittance = 0.02000000)});
/* ------------------------------------------------------------------ */
/* Primitives given in their own shell coordinate system.              */
/* ------------------------------------------------------------------ */

GEOMETRY SCS_DISC;
SCS_DISC = SHELL_SCS_DISC(
    rmin = 0.02000000,
    rmax = RADIUS,
    angmin = 0.00000000,
    angmax = 270.00000000,
    height = 0.05000000,
    nodes1 = NSECT,
    nodes2 = NRING,
    nbase1 = 1000,
    ndelta1 = 1,
    nbase2 = 1000,
    ndelta2 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_CYL;
SCS_CYL = SHELL_SCS_CYLINDER(
    radius = RADIUS,
    hmin = 0.00000000,
    hmax = 0.30000000,
    angmin = 0.00000000,
    angmax = FULL_TURN,
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 1100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Mirror,
    bulk = Alu,
    thick = 0.00200000);

GEOMETRY SCS_CONE;
SCS_CONE = SHELL_SCS_CONE(
    semi_ang = SEMI,
    hmin = 0.05000000,
    hmax = 0.25000000,
    angmin = 0.00000000,
    angmax = 180.00000000,
    nodes1 = 3,
    nodes2 = 2,
    nbase1 = 1200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_SPHERE;
SCS_SPHERE = SHELL_SCS_SPHERE(
    radius = RADIUS,
    lat_min = -60.00000000,
    lat_max = 60.00000000,
    long_min = 0.00000000,
    long_max = FULL_TURN,
    nodes1 = 4,
    nodes2 = 3,
    nbase1 = 1300,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_RECT;
SCS_RECT = SHELL_SCS_RECTANGLE(
    xmin = 0.00000000,
    xmax = 0.20000000,
    ymin = 0.00000000,
    ymax = 0.30000000,
    height = 0.10000000,
    meshType1 = "regular",
    nodes1 = 3,
    ratio1 = 2.00000000,
    meshType2 = "positions",
    meshPositions2 = CUTS,
    nbase1 = 1400,
    ndelta1_1 = 1,
    ndelta1_2 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_PARA;
SCS_PARA = SHELL_SCS_PARABOLOID(
    flength = 0.10000000,
    hmin = 0.00000000,
    hmax = 0.20000000,
    angmin = 0.00000000,
    angmax = FULL_TURN,
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 1500,
    ndelta1 = 1,
    opt1 = Mirror,
    opt2 = Black);

GEOMETRY SCS_BOX;
SCS_BOX = SHELL_SCS_BOX(
    xmax = 0.20000000,
    ymax = 0.30000000,
    height = 0.40000000,
    meshType1 = "regular",
    nodes1 = 1,
    ratio1 = 1.00000000,
    meshType2 = "regular",
    nodes2 = 1,
    ratio2 = 1.00000000,
    meshType3 = "regular",
    nodes3 = 1,
    ratio3 = 1.00000000,
    nbase1 = 1600,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_TRAP;
SCS_TRAP = SHELL_SCS_TRAPEZOID(
    beta_min = 0.10000000,
    beta_max = 0.30000000,
    gamma_min = 60.00000000,
    gamma_max = 120.00000000,
    height = 0.05000000,
    nodes1 = 3,
    nodes2 = 2,
    nbase1 = 1700,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_PRISM;
SCS_PRISM = SHELL_SCS_TRIANGULAR_PRISM(
    hmin = 0.00000000,
    hmax = 0.40000000,
    beta = 0.20000000,
    gamma_min = 60.00000000,
    gamma_max = 120.00000000,
    meshType1 = "regular",
    nodes1 = 1,
    ratio1 = 1.00000000,
    meshType4 = "regular",
    nodes4 = 1,
    ratio4 = 1.00000000,
    nbase1 = 1800,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* ------------------------------------------------------------------ */
/* The same shapes given by points.                                    */
/* ------------------------------------------------------------------ */

GEOMETRY PT_TRIANGLE;
PT_TRIANGLE = SHELL_TRIANGLE(
    point1 = [1.00000000, 0.00000000, 0.00000000],
    point2 = [1.30000000, 0.00000000, 0.00000000],
    point3 = [1.00000000, 0.40000000, 0.00000000],
    nbase1 = 2000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_RECT;
PT_RECT = SHELL_RECTANGLE(
    point1 = [1.00000000, 0.00000000, 0.50000000],
    point2 = [1.30000000, 0.00000000, 0.50000000],
    point4 = [1.00000000, 0.40000000, 0.50000000],
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 2100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_QUAD;
PT_QUAD = SHELL_QUADRILATERAL(
    point1 = [1.00000000, 0.00000000, 1.00000000],
    point2 = [1.30000000, 0.00000000, 1.00000000],
    point3 = [1.35000000, 0.40000000, 1.00000000],
    point4 = [1.00000000, 0.40000000, 1.00000000],
    nbase1 = 2200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_DISC;
PT_DISC = SHELL_DISC(
    point1 = [2.00000000, 0.00000000, 0.00000000],
    point2 = [2.00000000, 0.00000000, 1.00000000],
    point3 = [2.20000000, 0.00000000, 0.00000000],
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 2300,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_CYL;
PT_CYL = SHELL_CYLINDER(
    point1 = [2.00000000, 1.00000000, 0.00000000],
    point2 = [2.00000000, 1.00000000, 0.30000000],
    point3 = [2.15000000, 1.00000000, 0.00000000],
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 2400,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_CONE;
PT_CONE = SHELL_CONE(
    point1 = [2.00000000, 2.00000000, 0.40000000],
    point2 = [2.00000000, 2.00000000, 0.00000000],
    point3 = [2.20000000, 2.00000000, 0.00000000],
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 2500,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_SPHERE;
PT_SPHERE = SHELL_SPHERE(
    point1 = [3.00000000, 0.00000000, 0.00000000],
    point2 = [3.00000000, 0.00000000, 1.00000000],
    point3 = [3.20000000, 0.00000000, 0.00000000],
    nodes1 = 4,
    nodes2 = 3,
    nbase1 = 2600,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_PARA;
PT_PARA = SHELL_PARABOLOID(
    point1 = [3.00000000, 1.00000000, 0.00000000],
    point2 = [3.00000000, 1.00000000, 0.20000000],
    point3 = [3.20000000, 1.00000000, 0.20000000],
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 2700,
    ndelta1 = 1,
    opt1 = Mirror,
    opt2 = Black);

GEOMETRY PT_PRISM;
PT_PRISM = SHELL_TRIANGULAR_PRISM(
    point1 = [4.00000000, 0.00000000, 0.00000000],
    point2 = [4.30000000, 0.00000000, 0.00000000],
    point3 = [4.00000000, 0.40000000, 0.00000000],
    point4 = [4.00000000, 0.00000000, 0.20000000],
    nbase1 = 2800,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_BOX;
PT_BOX = SHELL_BOX(
    point1 = [4.00000000, 1.00000000, 0.00000000],
    point2 = [4.30000000, 1.00000000, 0.00000000],
    point3 = [4.00000000, 1.40000000, 0.00000000],
    point4 = [4.00000000, 1.00000000, 0.20000000],
    nbase1 = 2900,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* ------------------------------------------------------------------ */
/* Every per-side attribute on one surface.                            */
/* ------------------------------------------------------------------ */

GEOMETRY ATTRS;
ATTRS = SHELL_SCS_RECTANGLE(
    xmax = 0.50000000,
    ymax = 0.60000000,
    analysis_type = "Lumped Parameter",
    composition = "DUAL",
    bulk1 = Alu,
    thick1 = 0.00100000,
    bulk2 = Steel,
    thick2 = 0.00300000,
    through_cond = "BULK",
    conductance = 0.00000000,
    emittance = 0.00000000,
    meshType1 = "regular",
    nodes1 = 2,
    ratio1 = 1.00000000,
    meshType2 = "regular",
    nodes2 = 3,
    ratio2 = 1.00000000,
    side1 = "Active",
    label1 = "front",
    criticality1 = "CRITICAL",
    model1 = "PANELS",
    colour1 = "RED",
    opt1 = Black,
    nbase1 = 3000,
    ndelta1 = 1,
    side2 = "Inactive",
    label2 = "back",
    criticality2 = "NORMAL",
    model2 = "PANELS",
    colour2 = "BLUE",
    opt2 = Mirror,
    nbase2 = 4000,
    ndelta2 = 2);

/* Per-direction node increments: one scalar step cannot hold both. */

GEOMETRY SPLIT_DELTA;
SPLIT_DELTA = SHELL_SCS_RECTANGLE(
    xmax = 0.20000000,
    ymax = 0.30000000,
    nodes1 = 2,
    nodes2 = 3,
    nbase1 = 5000,
    ndelta1_1 = 1,
    ndelta1_2 = 10,
    opt1 = Black,
    opt2 = Black);

/* Attributes that survive the load but have nowhere to go here. */

GEOMETRY DROPPED_ATTRS;
DROPPED_ATTRS = SHELL_SCS_RECTANGLE(
    xmax = 0.20000000,
    ymax = 0.20000000,
    analysis_type = "Finite Element",
    sense = 1,
    nodes1 = 2,
    nodes2 = 2,
    side1 = "Radiative",
    side2 = "Conductive",
    nbase1 = 5300,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* Re-binding a variable after it has been used: the shapes already built keep
   the value they were given, so the two cones below differ. */

SEMI = 45.00000000;

GEOMETRY LATE_CONE;
LATE_CONE = SHELL_SCS_CONE(
    semi_ang = SEMI,
    hmin = 0.05000000,
    hmax = 0.25000000,
    nodes1 = 3,
    nodes2 = 2,
    nbase1 = 5500,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* Insulation needs its own surface: ESATAN refuses it on a finite-element one. */

GEOMETRY INSULATED;
INSULATED = SHELL_SCS_RECTANGLE(
    xmax = 0.20000000,
    ymax = 0.20000000,
    insulation1 = Blanket,
    nbase1 = 5400,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* A surface asking ESATAN to number it. */

GEOMETRY AUTO_NUM;
AUTO_NUM = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    opt1 = Black,
    opt2 = Black);

/* ------------------------------------------------------------------ */
/* Placement.                                                          */
/* ------------------------------------------------------------------ */

GEOMETRY MOVED;
MOVED = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.20000000,
    nbase1 = 5100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);
MOVED = ROTATE(object_name = MOVED, x_ang = 15.00000000, y_ang = 30.00000000, z_ang = 45.00000000);
MOVED = TRANSLATE(object_name = MOVED, x_dist = 5.00000000, y_dist = 1.00000000);

GEOMETRY CLEARED;
CLEARED = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.20000000,
    nbase1 = 5200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);
CLEARED = ROTATE(object_name = CLEARED, z_ang = 45.00000000);
CLEARED = TRANSLATE(object_name = CLEARED, x_dist = 5.00000000);
CLEARED = ROTATE(object_name = CLEARED, y_ang = 20.00000000, clear = TRUE);

/* ------------------------------------------------------------------ */
/* Structure: combine, cut, single combination, assembly.              */
/* ------------------------------------------------------------------ */

GEOMETRY CUT_TARGET;
CUT_TARGET = SHELL_SCS_RECTANGLE(
    xmin = -0.30000000,
    xmax = 0.30000000,
    ymin = -0.30000000,
    ymax = 0.30000000,
    height = 2.00000000,
    nodes1 = 4,
    nodes2 = 4,
    nbase1 = 6000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY CYL_CUTTER;
CYL_CUTTER = SHELL_SCS_CYLINDER(
    radius = 0.08000000,
    hmin = 1.90000000,
    hmax = 2.10000000,
    sense = -1,
    nbase1 = 6100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY BOX_CUTTER;
BOX_CUTTER = SHELL_SCS_BOX(
    xmin = 0.15000000,
    xmax = 0.35000000,
    ymin = 0.15000000,
    ymax = 0.35000000,
    height = 2.10000000,
    sense = -1,
    nbase1 = 6200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY DRILLED;
DRILLED = CUT_TARGET - CYL_CUTTER - BOX_CUTTER;

GEOMETRY SOLO;
SOLO = SINGLE_COMBINATION(geometry = PT_TRIANGLE);

GEOMETRY SCS_SHAPES;
SCS_SHAPES = SCS_DISC + SCS_CYL + SCS_CONE + SCS_SPHERE + SCS_RECT + SCS_PARA + SCS_BOX +
    SCS_TRAP + SCS_PRISM;

GEOMETRY PT_SHAPES;
PT_SHAPES = PT_RECT + PT_QUAD + PT_DISC + PT_CYL + PT_CONE + PT_SPHERE + PT_PARA +
    PT_PRISM + PT_BOX;

GEOMETRY STATIC_ASM;
STATIC_ASM = ASSEMBLE(
    ref_comp = SCS_SHAPES,
    moving_comp = PT_SHAPES,
    xt = 0.00000000,
    yt = 3.00000000,
    zt = 0.00000000,
    xr = 0.00000000,
    yr = 0.00000000,
    zr = 90.00000000,
    order = "xryrzrxtytzt",
    orientation = "NO_ORIENTATION");

GEOMETRY SPINNER;
SPINNER = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.20000000,
    nbase1 = 7000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY KINEMATIC_ASM;
KINEMATIC_ASM = ASSEMBLE(
    ref_comp = DRILLED,
    moving_comp = SPINNER,
    xt = 0.00000000,
    yt = 0.00000000,
    zt = 2.50000000,
    xr = 0.00000000,
    yr = 0.00000000,
    zr = 0.00000000,
    order = "xryrzrxtytzt",
    orientation = "ROTATE",
    point_vect = [1.00000000, 0.00000000, 0.00000000],
    rot_point = [0.00000000, 0.00000000, 2.50000000],
    rot_axis = [0.00000000, 0.00000000, 1.00000000],
    rot_min_ang = 0.00000000,
    rot_max_ang = 360.00000000,
    initial_angle = 30.00000000,
    rotation_rate = 6.00000000);

/* ------------------------------------------------------------------ */
/* The three ways of overriding an attribute after the fact.           */
/* ------------------------------------------------------------------ */

DEFINE_GEOMETRY_ATTRIBUTES(
    geometry = SOLO,
    shell_surfaces = {1, 2},
    nbase = 8000,
    ndelta = 1,
    optical = Mirror);

SET_ATTRIBUTE_RECURSIVE(geometry = PT_SHAPES,
    colour1 = "YELLOW",
    colour2 = "DARK_GREY",
    bulk = Alu,
    thick = 0.00150000);

AUTO_NUM.NBASE1 = 9000;
AUTO_NUM.NDELTA1 = 1;
AUTO_NUM.NBASE2 = 9000;
AUTO_NUM.NDELTA2 = 1;


/* ------------------------------------------------------------------ */
/* Arrays used as primitive corners.                                   */
/*                                                                     */
/* A POINT array is declared with a size, filled one element at a      */
/* time, and its elements are then named as the corners of a surface.  */
/* A REAL vector, whose elements are read the same way, is here for    */
/* comparison: the two share one subscript syntax and only the         */
/* declaration says which type an element has.  The array declared     */
/* with an initializer list is further up, so both spellings are here. */
/* ------------------------------------------------------------------ */

OPTICAL Low_e;
DEFINE_OPTICAL (
    optical = Low_e,
    ir_emiss = 0.40000000,
    solar_absorb = 0.40000000);

POINT grid[4];
grid[1] = [0.0, 0.0, 0.0];
grid[2] = [1.0, 0.0, 0.0];
grid[3] = [1.0, 1.0, 0.0];
grid[4] = [0.0, 1.0, 0.0];

REAL heights[2];
heights[1] = 0.25;
heights[2] = 0.75;

/* Corners taken straight out of the array. */
GEOMETRY T1;
T1 = SHELL_TRIANGLE(
    point1 = grid[1],
    point2 = grid[2],
    point3 = grid[3],
    nodes1 = 1,
    nodes2 = 1,
    nbase1 = 60000,
    ndelta1 = 1,
    opt1 = Low_e,
    opt2 = Low_e);

/* An element inside an expression, so an element is a value like any other and
   not only a literal in disguise. */
GEOMETRY T2;
T2 = SHELL_TRIANGLE(
    point1 = grid[1],
    point2 = grid[4],
    point3 = [0.0, 1.0, heights[2]],
    nodes1 = 1,
    nodes2 = 1,
    nbase1 = 60100,
    ndelta1 = 1,
    opt1 = Low_e,
    opt2 = Low_e);

GEOMETRY PT_ARRAY;
PT_ARRAY = T1 + T2;

/* ------------------------------------------------------------------ */
/* One plate cut by each of the remaining shapes a tool can be.  The   */
/* cylinder and the box are further up; a cone, a sphere and a         */
/* triangular prism are here.  Each removes what it encloses, which is */
/* `sense = -1`.                                                       */
/* ------------------------------------------------------------------ */

GEOMETRY SLAB;
SLAB = SHELL_SCS_RECTANGLE(
    xmin = -1.00000000,
    xmax = 1.00000000,
    ymin = -1.00000000,
    ymax = 1.00000000,
    height = 0.00000000,
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 61000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY CONE_TOOL;
CONE_TOOL = SHELL_SCS_CONE(
    semi_ang = 30.00000000,
    hmin = 0.10000000,
    hmax = 0.40000000,
    sense = -1,
    nbase1 = 61100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);
CONE_TOOL = TRANSLATE(object_name = CONE_TOOL, x_dist = -0.50000000, z_dist = -0.20000000);

GEOMETRY SPHERE_TOOL;
SPHERE_TOOL = SHELL_SCS_SPHERE(
    radius = 0.20000000,
    sense = -1,
    nbase1 = 61200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);
SPHERE_TOOL = TRANSLATE(object_name = SPHERE_TOOL, x_dist = 0.50000000);

GEOMETRY PRISM_TOOL;
PRISM_TOOL = SHELL_TRIANGULAR_PRISM(
    point1 = [-0.20000000, -0.70000000, -0.20000000],
    point2 = [0.20000000, -0.70000000, -0.20000000],
    point3 = [0.00000000, -0.40000000, -0.20000000],
    point4 = [0.00000000, 0.00000000, 0.40000000],
    sense = -1,
    nbase1 = 61300,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY HOLED;
HOLED = SLAB - CONE_TOOL - SPHERE_TOOL - PRISM_TOOL;

/* ------------------------------------------------------------------ */
/* Every face with a node of its own, on both sides, so that one node  */
/* names exactly one face and `expected_faces.csv` can give that       */
/* face's area and the position of its parametric centre.  These       */
/* shapes are order 1, so six decimals leave plenty of margin, and     */
/* their meshes are uneven so that swapping the two parametric         */
/* directions moves the numbers.                                       */
/* ------------------------------------------------------------------ */

GEOMETRY TRAP;
TRAP = SHELL_SCS_TRAPEZOID(
    beta_min = 1.00000000,
    beta_max = 3.00000000,
    gamma_min = 60.00000000,
    gamma_max = 120.00000000,
    height = 0.50000000,
    nodes1 = 3,
    nodes2 = 2,
    nbase1 = 62000,
    ndelta1 = 1,
    nbase2 = 62050,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

GEOMETRY QUAD;
QUAD = SHELL_QUADRILATERAL(
    point1 = [5.00000000, 0.00000000, 0.00000000],
    point2 = [7.00000000, 0.00000000, 0.00000000],
    point3 = [6.50000000, 2.00000000, 0.00000000],
    point4 = [5.50000000, 2.00000000, 0.00000000],
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 62100,
    ndelta1 = 1,
    nbase2 = 62150,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

GEOMETRY RECT;
RECT = SHELL_SCS_RECTANGLE(
    xmin = 0.00000000,
    xmax = 2.00000000,
    ymin = 0.00000000,
    ymax = 1.00000000,
    height = -1.00000000,
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 62200,
    ndelta1 = 1,
    nbase2 = 62250,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

GEOMETRY TRI;
TRI = SHELL_TRIANGLE(
    point1 = [0.00000000, 5.00000000, 0.00000000],
    point2 = [2.00000000, 5.00000000, 0.00000000],
    point3 = [0.00000000, 8.00000000, 0.00000000],
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 62300,
    ndelta1 = 1,
    nbase2 = 62350,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

GEOMETRY DISC;
DISC = SHELL_SCS_DISC(
    rmin = 0.20000000,
    rmax = 1.00000000,
    angmin = 0.00000000,
    angmax = 90.00000000,
    height = 3.00000000,
    nodes1 = 2,
    nodes2 = 3,
    nbase1 = 62400,
    ndelta1 = 1,
    nbase2 = 62450,
    ndelta2 = 1,
    thick = 0.00200000,
    bulk = Alu,
    opt1 = Black,
    opt2 = Black);

GEOMETRY FACES;
FACES = TRAP + QUAD + RECT + TRI + DISC;


/* ------------------------------------------------------------------ */
/* The attribute bank.                                                 */
/*                                                                     */
/* One rectangle per attribute combination, all the same shape and one */
/* node base apart, so that what separates any two of them is the      */
/* attributes and nothing else.  Nothing here is meant to describe      */
/* hardware: the shapes sit on top of one another and the numbers are  */
/* chosen to be told apart, not to be plausible.                       */
/* ------------------------------------------------------------------ */

/* Nothing but the minimum: every default left implicit. */

GEOMETRY BANK_IMPLICIT;
BANK_IMPLICIT = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    nbase1 = 70000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* The same surface with every default spelled out.  Reading the two has to
   give the same thing, which is the whole claim a default makes. */

GEOMETRY BANK_EXPLICIT;
BANK_EXPLICIT = SHELL_SCS_RECTANGLE(
    xmin = 0.00000000,
    xmax = 0.10000000,
    ymin = 0.00000000,
    ymax = 0.10000000,
    height = 0.00000000,
    sense = 1,
    analysis_type = "Lumped Parameter",
    composition = "SINGLE",
    meshType1 = "regular",
    nodes1 = 1,
    ratio1 = 1.00000000,
    meshType2 = "regular",
    nodes2 = 1,
    ratio2 = 1.00000000,
    side1 = "Active",
    nbase1 = 71000,
    ndelta1 = 1,
    opt1 = Black,
    side2 = "Active",
    nbase2 = 71500,
    ndelta2 = 1,
    opt2 = Black);

/* One side taking no part at all. */

GEOMETRY BANK_INACTIVE;
BANK_INACTIVE = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    side1 = "Active",
    side2 = "Inactive",
    nbase1 = 72000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* One side radiating and the other conducting: two activities, one per
   calculation, so neither costs the other anything. */

GEOMETRY BANK_ACTIVITIES;
BANK_ACTIVITIES = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    side1 = "Radiative",
    side2 = "Conductive",
    nbase1 = 73000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* One thickness for the whole shell, shared between the conducting sides. */

GEOMETRY BANK_SINGLE;
BANK_SINGLE = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    composition = "SINGLE",
    bulk = Alu,
    thick = 0.00200000,
    nbase1 = 74000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* A thickness and a material of its own on each side. */

GEOMETRY BANK_DUAL;
BANK_DUAL = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    composition = "DUAL",
    bulk1 = Alu,
    thick1 = 0.00100000,
    bulk2 = Laminate,
    thick2 = 0.00400000,
    nbase1 = 75000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Mirror);

/* Insulation, which needs a surface of its own. */

GEOMETRY BANK_INSULATION;
BANK_INSULATION = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    insulation1 = Blanket,
    insulation2 = Blanket,
    nbase1 = 76000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* Bookkeeping this model has nowhere to keep: names, criticalities and the
   sub-model a surface belongs to. */

GEOMETRY BANK_BOOKKEEPING;
BANK_BOOKKEEPING = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    label1 = "bank front",
    criticality1 = "CRITICAL",
    model1 = "BANK",
    label2 = "bank back",
    criticality2 = "NORMAL",
    model2 = "BANK",
    nbase1 = 77000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* A node-number increment per direction, which one scalar step cannot hold. */

GEOMETRY BANK_SPLIT_DELTA;
BANK_SPLIT_DELTA = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    nodes1 = 2,
    nodes2 = 3,
    nbase1 = 78000,
    ndelta1_1 = 1,
    ndelta1_2 = 20,
    opt1 = Black,
    opt2 = Black);

/* A regular mesh with a ratio in each direction: cuts that grow. */

GEOMETRY BANK_REGULAR;
BANK_REGULAR = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    meshType1 = "regular",
    nodes1 = 3,
    ratio1 = 2.00000000,
    meshType2 = "regular",
    nodes2 = 2,
    ratio2 = 3.00000000,
    nbase1 = 79000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* The same mesh said the other way: the interior cuts given outright, once
   from an array declared with an initializer list and once from one filled
   element by element. */

REAL SPACING[2];
SPACING[1] = 0.30000000;
SPACING[2] = 0.60000000;

GEOMETRY BANK_POSITIONS;
BANK_POSITIONS = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    meshType1 = "positions",
    meshPositions1 = CUTS,
    meshType2 = "positions",
    meshPositions2 = SPACING,
    nbase1 = 80000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* The through-thickness quantities, which generate no couplings here.  The
   other analysis type is on a surface of its own further up: a second one
   would only report the same thing twice. */

GEOMETRY BANK_THROUGH_THICKNESS;
BANK_THROUGH_THICKNESS = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    analysis_type = "Lumped Parameter",
    through_cond = "USER",
    conductance = 12.00000000,
    emittance = 0.05000000,
    nbase1 = 81000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* A colour on each side, named from the format's palette. */

GEOMETRY BANK_COLOURS;
BANK_COLOURS = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    colour1 = "GREEN",
    colour2 = "MAGENTA",
    nbase1 = 82000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY BANK;
BANK = BANK_IMPLICIT + BANK_EXPLICIT + BANK_INACTIVE + BANK_ACTIVITIES + BANK_SINGLE +
    BANK_DUAL + BANK_INSULATION + BANK_BOOKKEEPING + BANK_SPLIT_DELTA + BANK_REGULAR +
    BANK_POSITIONS + BANK_THROUGH_THICKNESS + BANK_COLOURS;

/* ------------------------------------------------------------------ */

FEATURES = STATIC_ASM + KINEMATIC_ASM + SOLO + ATTRS + SPLIT_DELTA + AUTO_NUM +
    MOVED + CLEARED + DROPPED_ATTRS + INSULATED + LATE_CONE + PT_ARRAY + HOLED + FACES +
    BANK;

END_MODEL
