BEGIN_MODEL CUTTERS

/* One plate cut by every shape that can act as a cutting tool: a cone, a
   sphere, a paraboloid and a triangular prism.  Each removes what it encloses,
   which is `sense = -1`.  Every surface carries an optical material because a
   surface without one cannot be exchanged. */

OPTICAL Black;
Black = [0.90, 0.10, 0.00, 0.90, 0.10, 0.00, 0.00, 0.00];

GEOMETRY SLAB;
SLAB = SHELL_SCS_RECTANGLE(
    xmin = -1.00000000,
    xmax = 1.00000000,
    ymin = -1.00000000,
    ymax = 1.00000000,
    height = 0.00000000,
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 1000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY CONE_TOOL;
CONE_TOOL = SHELL_SCS_CONE(
    semi_ang = 30.00000000,
    hmin = 0.10000000,
    hmax = 0.40000000,
    sense = -1,
    nbase1 = 2000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);
CONE_TOOL = TRANSLATE(object_name = CONE_TOOL, x_dist = -0.50000000, z_dist = -0.20000000);

GEOMETRY SPHERE_TOOL;
SPHERE_TOOL = SHELL_SCS_SPHERE(
    radius = 0.20000000,
    sense = -1,
    nbase1 = 2100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);
SPHERE_TOOL = TRANSLATE(object_name = SPHERE_TOOL, x_dist = 0.50000000);

GEOMETRY PARA_TOOL;
PARA_TOOL = SHELL_SCS_PARABOLOID(
    flength = 0.10000000,
    hmin = 0.00000000,
    hmax = 0.30000000,
    sense = -1,
    nbase1 = 2200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);
PARA_TOOL = TRANSLATE(object_name = PARA_TOOL, y_dist = 0.50000000, z_dist = -0.15000000);

GEOMETRY PRISM_TOOL;
PRISM_TOOL = SHELL_TRIANGULAR_PRISM(
    point1 = [-0.20000000, -0.70000000, -0.20000000],
    point2 = [0.20000000, -0.70000000, -0.20000000],
    point3 = [0.00000000, -0.40000000, -0.20000000],
    point4 = [0.00000000, 0.00000000, 0.40000000],
    sense = -1,
    nbase1 = 2300,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY HOLED;
HOLED = SLAB - CONE_TOOL - SPHERE_TOOL - PARA_TOOL - PRISM_TOOL;

CUTTERS = HOLED;

END_MODEL
