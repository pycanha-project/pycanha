BEGIN_MODEL FEATURES_TAS

/* ------------------------------------------------------------------ */
/* Independent variables: declarations, expressions, vectors, points.  */
/* ------------------------------------------------------------------ */

CONST REAL FULL_TURN = 360.00000000;

REAL RADIUS = 0.10000000;
REAL HALF;
HALF = RADIUS / 2.00000000;
REAL SEMI = 30.00000000;
REAL SLOPE;
SLOPE = TAN(SEMI);
REAL SPAN;
SPAN = SQRT(RADIUS * RADIUS + HALF * HALF);
INTEGER NRING = 3;
INTEGER NSECT = 4;

REAL CUTS[3] =
{0.25000000, 0.50000000, 0.75000000};

POINT PO;
PO = [0.00000000, 0.00000000, 0.00000000];
POINT PX;
PX = [0.20000000, 0.00000000, 0.00000000];
POINT PY;
PY = [0.00000000, 0.20000000, 0.00000000];
POINT PZ;
PZ = [0.00000000, 0.00000000, 0.20000000];

/* ------------------------------------------------------------------ */
/* Materials.                                                          */
/* ------------------------------------------------------------------ */

OPTICAL Black;
Black       = [0.90, 0.10, 0.00, 0.90, 0.10, 0.00, 0.00, 0.00];
Black [BOL] = [0.85, 0.15, 0.00, 0.86, 0.14, 0.00, 0.00, 0.00];
Black [EOL] = [0.92, 0.08, 0.00, 0.94, 0.06, 0.00, 0.00, 0.00];

OPTICAL Mirror;
DEFINE_OPTICAL (
    optical = Mirror,
    ir_emiss = 0.05000000,
    ir_transm = 0.00000000,
    solar_absorb = 0.12000000,
    solar_transm = 0.00000000,
    ir_spec_refl = 0.90000000,
    solar_spec_refl = 0.85000000);

BULK Alu;
Alu = [2700.00000000, 900.00000000, 160.00000000];

BULK Steel;
DEFINE_BULK (
    bulk = Steel,
    density = 7900.00000000,
    sp_heat = 500.00000000,
    type = "Isotropic",
    cond = 15.00000000);

BULK Laminate;
DEFINE_BULK (
    bulk = Laminate,
    density = 1600.00000000,
    sp_heat = 1100.00000000,
    type = "Orthotropic",
    cond1 = 40.00000000,
    cond2 = 4.00000000,
    cond3 = 0.40000000);

INSULATION Blanket;
Blanket = DEFINE_INSULATION(
    optical = Black,
    layers = {DEFINE_LAYER(
        node_offset = 500000,
        submodel_name = "MLI",
        thickness = 0.01000000,
        bulk = Steel,
        through_cond = "BULK",
        emittance = 0.02000000)});
/* ------------------------------------------------------------------ */
/* Primitives given in their own shell coordinate system.              */
/* ------------------------------------------------------------------ */

GEOMETRY SCS_DISC;
SCS_DISC = SHELL_SCS_DISC(
    rmin = 0.02000000,
    rmax = RADIUS,
    angmin = 0.00000000,
    angmax = 270.00000000,
    height = 0.05000000,
    nodes1 = NSECT,
    nodes2 = NRING,
    nbase1 = 1000,
    ndelta1 = 1,
    nbase2 = 1000,
    ndelta2 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_CYL;
SCS_CYL = SHELL_SCS_CYLINDER(
    radius = RADIUS,
    hmin = 0.00000000,
    hmax = 0.30000000,
    angmin = 0.00000000,
    angmax = FULL_TURN,
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 1100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Mirror,
    bulk = Alu,
    thick = 0.00200000);

GEOMETRY SCS_CONE;
SCS_CONE = SHELL_SCS_CONE(
    semi_ang = SEMI,
    hmin = 0.05000000,
    hmax = 0.25000000,
    angmin = 0.00000000,
    angmax = 180.00000000,
    nodes1 = 3,
    nodes2 = 2,
    nbase1 = 1200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_SPHERE;
SCS_SPHERE = SHELL_SCS_SPHERE(
    radius = RADIUS,
    lat_min = -60.00000000,
    lat_max = 60.00000000,
    long_min = 0.00000000,
    long_max = FULL_TURN,
    nodes1 = 4,
    nodes2 = 3,
    nbase1 = 1300,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_RECT;
SCS_RECT = SHELL_SCS_RECTANGLE(
    xmin = 0.00000000,
    xmax = 0.20000000,
    ymin = 0.00000000,
    ymax = 0.30000000,
    height = 0.10000000,
    meshType1 = "regular",
    nodes1 = 3,
    ratio1 = 2.00000000,
    meshType2 = "positions",
    meshPositions2 = CUTS,
    nbase1 = 1400,
    ndelta1_1 = 1,
    ndelta1_2 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY SCS_PARA;
SCS_PARA = SHELL_SCS_PARABOLOID(
    flength = 0.10000000,
    hmin = 0.00000000,
    hmax = 0.20000000,
    angmin = 0.00000000,
    angmax = FULL_TURN,
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 1500,
    ndelta1 = 1,
    opt1 = Mirror,
    opt2 = Black);

GEOMETRY SCS_BOX;
SCS_BOX = SHELL_SCS_BOX(
    xmax = 0.20000000,
    ymax = 0.30000000,
    height = 0.40000000,
    nodes1 = 1,
    nodes2 = 1,
    nodes3 = 1,
    nbase1 = 1600,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* ------------------------------------------------------------------ */
/* The same shapes given by points.                                    */
/* ------------------------------------------------------------------ */

GEOMETRY PT_TRIANGLE;
PT_TRIANGLE = SHELL_TRIANGLE(
    point1 = [1.00000000, 0.00000000, 0.00000000],
    point2 = [1.30000000, 0.00000000, 0.00000000],
    point3 = [1.00000000, 0.40000000, 0.00000000],
    nbase1 = 2000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_RECT;
PT_RECT = SHELL_RECTANGLE(
    point1 = [1.00000000, 0.00000000, 0.50000000],
    point2 = [1.30000000, 0.00000000, 0.50000000],
    point4 = [1.00000000, 0.40000000, 0.50000000],
    nodes1 = 2,
    nodes2 = 2,
    nbase1 = 2100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_QUAD;
PT_QUAD = SHELL_QUADRILATERAL(
    point1 = [1.00000000, 0.00000000, 1.00000000],
    point2 = [1.30000000, 0.00000000, 1.00000000],
    point3 = [1.35000000, 0.40000000, 1.00000000],
    point4 = [1.00000000, 0.40000000, 1.00000000],
    nbase1 = 2200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_DISC;
PT_DISC = SHELL_DISC(
    point1 = [2.00000000, 0.00000000, 0.00000000],
    point2 = [2.00000000, 0.00000000, 1.00000000],
    point3 = [2.20000000, 0.00000000, 0.00000000],
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 2300,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_CYL;
PT_CYL = SHELL_CYLINDER(
    point1 = [2.00000000, 1.00000000, 0.00000000],
    point2 = [2.00000000, 1.00000000, 0.30000000],
    point3 = [2.15000000, 1.00000000, 0.00000000],
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 2400,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_CONE;
PT_CONE = SHELL_CONE(
    point1 = [2.00000000, 2.00000000, 0.40000000],
    point2 = [2.00000000, 2.00000000, 0.00000000],
    point3 = [2.20000000, 2.00000000, 0.00000000],
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 2500,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_SPHERE;
PT_SPHERE = SHELL_SPHERE(
    point1 = [3.00000000, 0.00000000, 0.00000000],
    point2 = [3.00000000, 0.00000000, 1.00000000],
    point3 = [3.20000000, 0.00000000, 0.00000000],
    nodes1 = 4,
    nodes2 = 3,
    nbase1 = 2600,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_PARA;
PT_PARA = SHELL_PARABOLOID(
    point1 = [3.00000000, 1.00000000, 0.00000000],
    point2 = [3.00000000, 1.00000000, 0.20000000],
    point3 = [3.20000000, 1.00000000, 0.20000000],
    nodes1 = 4,
    nodes2 = 2,
    nbase1 = 2700,
    ndelta1 = 1,
    opt1 = Mirror,
    opt2 = Black);

GEOMETRY PT_PRISM;
PT_PRISM = SHELL_TRIANGULAR_PRISM(
    point1 = [4.00000000, 0.00000000, 0.00000000],
    point2 = [4.30000000, 0.00000000, 0.00000000],
    point3 = [4.00000000, 0.40000000, 0.00000000],
    point4 = [4.00000000, 0.00000000, 0.20000000],
    nbase1 = 2800,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY PT_BOX;
PT_BOX = SHELL_BOX(
    point1 = [4.00000000, 1.00000000, 0.00000000],
    point2 = [4.30000000, 1.00000000, 0.00000000],
    point3 = [4.00000000, 1.40000000, 0.00000000],
    point4 = [4.00000000, 1.00000000, 0.20000000],
    nbase1 = 2900,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* ------------------------------------------------------------------ */
/* Every per-side attribute on one surface.                            */
/* ------------------------------------------------------------------ */

GEOMETRY ATTRS;
ATTRS = SHELL_SCS_RECTANGLE(
    xmax = 0.50000000,
    ymax = 0.60000000,
    analysis_type = "Lumped Parameter",
    composition = "DUAL",
    bulk1 = Alu,
    thick1 = 0.00100000,
    bulk2 = Steel,
    thick2 = 0.00300000,
    through_cond = "BULK",
    meshType1 = "regular",
    nodes1 = 2,
    ratio1 = 1.00000000,
    meshType2 = "regular",
    nodes2 = 3,
    ratio2 = 1.00000000,
    side1 = "Active",
    label1 = "front",
    criticality1 = "CRITICAL",
    model1 = "PANELS",
    colour1 = "RED",
    opt1 = Black,
    nbase1 = 3000,
    ndelta1 = 1,
    side2 = "Inactive",
    label2 = "back",
    criticality2 = "NORMAL",
    model2 = "PANELS",
    colour2 = "BLUE",
    opt2 = Mirror,
    nbase2 = 4000,
    ndelta2 = 2);

/* Per-direction node increments: one scalar step cannot hold both. */

GEOMETRY SPLIT_DELTA;
SPLIT_DELTA = SHELL_SCS_RECTANGLE(
    xmax = 0.20000000,
    ymax = 0.30000000,
    nodes1 = 2,
    nodes2 = 3,
    nbase1 = 5000,
    ndelta1_1 = 1,
    ndelta1_2 = 10,
    opt1 = Black,
    opt2 = Black);

/* Attributes that survive the load but have nowhere to go here. */

GEOMETRY DROPPED_ATTRS;
DROPPED_ATTRS = SHELL_SCS_RECTANGLE(
    xmax = 0.20000000,
    ymax = 0.20000000,
    analysis_type = "Finite Element",
    sense = 1,
    nodes1 = 2,
    nodes2 = 2,
    side1 = "Radiative",
    side2 = "Conductive",
    nbase1 = 5300,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* Re-binding a variable after it has been used: the shapes already built keep
   the value they were given, so the two cones below differ. */

SEMI = 45.00000000;

GEOMETRY LATE_CONE;
LATE_CONE = SHELL_SCS_CONE(
    semi_ang = SEMI,
    hmin = 0.05000000,
    hmax = 0.25000000,
    nodes1 = 3,
    nodes2 = 2,
    nbase1 = 5500,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* Insulation needs its own surface: ESATAN refuses it on a finite-element one. */

GEOMETRY INSULATED;
INSULATED = SHELL_SCS_RECTANGLE(
    xmax = 0.20000000,
    ymax = 0.20000000,
    insulation1 = Blanket,
    nbase1 = 5400,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

/* A surface asking ESATAN to number it. */

GEOMETRY AUTO_NUM;
AUTO_NUM = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.10000000,
    opt1 = Black,
    opt2 = Black);

/* ------------------------------------------------------------------ */
/* Placement.                                                          */
/* ------------------------------------------------------------------ */

GEOMETRY MOVED;
MOVED = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.20000000,
    nbase1 = 5100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);
MOVED = ROTATE(object_name = MOVED, x_ang = 15.00000000, y_ang = 30.00000000, z_ang = 45.00000000);
MOVED = TRANSLATE(object_name = MOVED, x_dist = 5.00000000, y_dist = 1.00000000);

GEOMETRY CLEARED;
CLEARED = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.20000000,
    nbase1 = 5200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);
CLEARED = ROTATE(object_name = CLEARED, z_ang = 45.00000000);
CLEARED = TRANSLATE(object_name = CLEARED, x_dist = 5.00000000);
CLEARED = ROTATE(object_name = CLEARED, y_ang = 20.00000000, clear = TRUE);

/* ------------------------------------------------------------------ */
/* Structure: combine, cut, single combination, assembly.              */
/* ------------------------------------------------------------------ */

GEOMETRY CUT_TARGET;
CUT_TARGET = SHELL_SCS_RECTANGLE(
    xmin = -0.30000000,
    xmax = 0.30000000,
    ymin = -0.30000000,
    ymax = 0.30000000,
    height = 2.00000000,
    nodes1 = 4,
    nodes2 = 4,
    nbase1 = 6000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY CYL_CUTTER;
CYL_CUTTER = SHELL_SCS_CYLINDER(
    radius = 0.08000000,
    hmin = 1.90000000,
    hmax = 2.10000000,
    sense = -1,
    nbase1 = 6100,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY BOX_CUTTER;
BOX_CUTTER = SHELL_SCS_BOX(
    xmin = 0.15000000,
    xmax = 0.35000000,
    ymin = 0.15000000,
    ymax = 0.35000000,
    height = 2.10000000,
    sense = -1,
    nbase1 = 6200,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY DRILLED;
DRILLED = CUT_TARGET - CYL_CUTTER - BOX_CUTTER;

GEOMETRY SOLO;
SOLO = SINGLE_COMBINATION(geometry = PT_TRIANGLE);

GEOMETRY SCS_SHAPES;
SCS_SHAPES = SCS_DISC + SCS_CYL + SCS_CONE + SCS_SPHERE + SCS_RECT + SCS_PARA + SCS_BOX;

GEOMETRY PT_SHAPES;
PT_SHAPES = PT_RECT + PT_QUAD + PT_DISC + PT_CYL + PT_CONE + PT_SPHERE + PT_PARA +
    PT_PRISM + PT_BOX;

GEOMETRY STATIC_ASM;
STATIC_ASM = ASSEMBLE(
    ref_comp = SCS_SHAPES,
    moving_comp = PT_SHAPES,
    xt = 0.00000000,
    yt = 3.00000000,
    zt = 0.00000000,
    xr = 0.00000000,
    yr = 0.00000000,
    zr = 90.00000000,
    order = "xryrzrxtytzt",
    orientation = "NO_ORIENTATION");

GEOMETRY SPINNER;
SPINNER = SHELL_SCS_RECTANGLE(
    xmax = 0.10000000,
    ymax = 0.20000000,
    nbase1 = 7000,
    ndelta1 = 1,
    opt1 = Black,
    opt2 = Black);

GEOMETRY KINEMATIC_ASM;
KINEMATIC_ASM = ASSEMBLE(
    ref_comp = DRILLED,
    moving_comp = SPINNER,
    xt = 0.00000000,
    yt = 0.00000000,
    zt = 2.50000000,
    xr = 0.00000000,
    yr = 0.00000000,
    zr = 0.00000000,
    order = "xryrzrxtytzt",
    orientation = "ROTATE",
    point_vect = [1.00000000, 0.00000000, 0.00000000],
    rot_point = [0.00000000, 0.00000000, 2.50000000],
    rot_axis = [0.00000000, 0.00000000, 1.00000000],
    rot_min_ang = 0.00000000,
    rot_max_ang = 360.00000000,
    initial_angle = 30.00000000,
    rotation_rate = 6.00000000);

/* ------------------------------------------------------------------ */
/* The three ways of overriding an attribute after the fact.           */
/* ------------------------------------------------------------------ */

DEFINE_GEOMETRY_ATTRIBUTES(
    geometry = SOLO,
    shell_surfaces = {1, 2},
    nbase = 8000,
    ndelta = 1,
    optical = Mirror);

SET_ATTRIBUTE_RECURSIVE(geometry = PT_SHAPES,
    colour1 = "YELLOW",
    colour2 = "DARK_GREY",
    bulk = Alu,
    thick = 0.00150000);

AUTO_NUM.NBASE1 = 9000;
AUTO_NUM.NDELTA1 = 1;
AUTO_NUM.NBASE2 = 9000;
AUTO_NUM.NDELTA2 = 1;

/* ------------------------------------------------------------------ */

FEATURES_TAS = STATIC_ASM + KINEMATIC_ASM + SOLO + ATTRS + SPLIT_DELTA + AUTO_NUM +
    MOVED + CLEARED + DROPPED_ATTRS + INSULATED + LATE_CONE;

END_MODEL
