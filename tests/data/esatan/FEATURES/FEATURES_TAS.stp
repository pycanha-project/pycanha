#492=NRF_NETWORK_NODE_CLASS('meshed_bounded_surface','A bounded surface with a meshed set of faces. The activity and possible notional thickness of the surface sides, as well as the associated materials are defined through attributes of tas_meshed_primitive_bounded_surface. This node class should be applied to all meshed surface subtypes of tas_any_meshed_geometric_item in a tas_meshed_geometric_model.',$);
#493=NRF_NETWORK_NODE_CLASS('thermal_network_node','Thermal node in thermal or thermal-hydraulic network model',$);
#494=NRF_NETWORK_NODE_CLASS('fluid_network_node','Fluid node in thermal-hydraulic network model',$);
#495=NRF_NETWORK_NODE_RELATIONSHIP_CLASS('thermal_network_linear_conductor','Linear conductor between two thermal network (thermal and/or fluid) nodes',$);
#496=NRF_NETWORK_NODE_RELATIONSHIP_CLASS('thermal_network_radiative_coupling','Radiative coupling between two thermal network (thermal and/or fluid) nodes',$);
#497=NRF_NETWORK_NODE_RELATIONSHIP_CLASS('thermal_network_one_way_linear_conductor','One-way lineary conductor between two thermal network nodes. Either node may be a thermal or a fluid node. Heat flow is only possible from the first node to the second node.',$);
#498=NRF_NETWORK_NODE_RELATIONSHIP_CLASS('thermal_network_fluid_conductance','Fluid conductance between two fluid nodes in a thermal-hydraulic network network model.',$);
#499=NRF_NETWORK_NODE_RELATIONSHIP_CLASS('thermal_network_mass_flow_link','Mass flow link between two fluid nodes in a thermal-hydraulic network network model.',$);
#500=NRF_NETWORK_NODE_RELATIONSHIP_CLASS('thermal_network_view_factor','View factor between two thermal nodes in a thermal network model.',$);
#501=NRF_NETWORK_MODEL_CLASS('thermal_radiative_conductive_model','Thermal radiative and conductive model. Also often referred to as the geometric mathematical model (GMM). This model class should be assigned to a tas_meshed_geometric_model.',$,(#492),());
#502=NRF_NETWORK_MODEL_CLASS('thermal_network_model','Thermal network model. Also often referred to as the thermal mathematical model (TMM).',$,(#493),(#496,#495,#497,#500));
#503=NRF_NETWORK_MODEL_CLASS('thermal_hydraulic_network_model','Thermal-hydraulic network model. Adds representation of a fluid flow network to a thermal network model.',$,(#493,#494),(#496,#499,#495,#497,#500,#498));
#504=NRF_MATERIAL_CLASS('thermo_optical_surface_material','Class of surface materials with known thermo-optical properties.',$,(),('solar_absorptance','solar_direct_transmittance','solar_diffuse_transmittance','solar_specularity','solar_refraction_index','infra_red_emittance','infra_red_direct_transmittance','infra_red_diffuse_transmittance','infra_red_specularity','infra_red_refraction_index'));
#505=NRF_MATERIAL_CLASS('thermal_bulk_material','Class of bulk materials with known thermo-physical properties.',$,(),('mass_density','constant_pressure_specific_heat_capacity','thermal_conductivity'));
#506=NRF_MATERIAL_CLASS('thermal_material','Class of materials with known thermo-optical and thermo-physical properties.',$,(#504,#505),());
#507=NRF_MATERIAL_CLASS('heat_transfer_fluid','Class of heat transfer fluids with known thermo-physical properties.',$,(),('mass_density','dynamic_viscosity','surface_tension','enthalpy','saturation_enthalpy','saturation_temperature','saturation_pressure','constant_pressure_specific_heat_capacity','thermal_conductivity'));
#508=SMA_CELESTIAL_BODY_CLASS('star','a massive, luminous ball of plasma',$);
#509=SMA_CELESTIAL_BODY_CLASS('planet','as defined by the International Astronomical Union (IAU), is a celestial body orbiting a star or stellar remnant that is massive enough to be rounded by its own gravity, not massive enough to cause thermonuclear fusion, and has cleared its neighbouring region of planetesimals.',$);
#510=SMA_CELESTIAL_BODY_CLASS('moon','a celestial body that orbits a planet or smaller body, which is called the primary. Technically, the term natural satellite could refer to a planet orbiting a star, or a dwarf galaxy orbiting a major galaxy, but it is normally synonymous with moon and used to identify non-artificial satellites of planets, dwarf planets, and minor planets. (There are no known natural satellites of moons.)',$);
#511=SMA_CELESTIAL_BODY_CLASS('comet','loose collection of ice, dust, and small rocky particles in the Solar System that orbits the Sun and, when close enough to the Sun, exhibits a visible coma (or atmosphere) and/or a tail, both primarily from the effects of solar radiation upon the comet''s nucleus. The nucleus itself measures a few kilometres or tens of kilometres across, and is composed mostly of rock, dust and ice.',$);
#512=SMA_CELESTIAL_BODY_CLASS('asteroid','minor celestial bodies of the Solar system orbiting the Sun (mostly Small solar system bodies) that are smaller than major planets, but larger than meteoroids (commonly defined as being 10 meters across or less), and that are not comets. The distinction is made on visual appearance when discovered: comets must show a perceptible coma, and they get listed in their own catalogs.',$);
