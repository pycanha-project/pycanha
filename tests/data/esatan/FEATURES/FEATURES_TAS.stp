#344=NRF_ENUMERATION_ITEM('gamma_50_vernal_equinox','The inertial reference direction is the vernal equinox direction at epoch 1950-01-01 00:00 UTC.');
#345=NRF_ENUMERATION_ITEM('J2000_vernal_equinox','The inertial reference direction is the vernal equinox direction at epoch Julian date 2451545.0 TT or 2000-01-01T12:00:00 TT. This epoch can also be expressed as 2000-01-01T11:59:27.816 TAI or 2000-01-01T11:58:55.816 UTC.');
#346=NRF_ENUMERATION_ITEM('true_of_date_vernal_equinox','The inertial reference direction is true-of-date vernal equinox direction.');
