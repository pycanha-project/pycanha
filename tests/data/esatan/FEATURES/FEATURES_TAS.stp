#337=NRF_ENUMERATION_ITEM('star_centric_inertial_ecliptic','An inertial right-handed coordinate system with its origin at the centre of the governing star with the +Z axis normal to the ecliptica in the North direction and the +X axis along a specified tas_standard_direction_in_space. The +Y axis completes the right-handed coordinate system.');
#338=NRF_ENUMERATION_ITEM('planet_centric_star_fixed_equatorial','A right-handed coordinate system with its origin at the centre of the governing planet with the +Z axis along the planet''s celestial North pole direction and the +X axis in the plane formed by the +Z axis and the vector from the planet''s centre to the star''s centre. The +Y axis completes the right-handed coordinate system.');
#339=NRF_ENUMERATION_ITEM('planet_centric_inertial_ecliptic','An inertial right-handed coordinate system with its origin at the centre of the governing planet with the +Z axis normal to the ecliptica in the North direction and the +X axis along a specified tas_standard_direction_in_space. The +Y axis completes the right-handed coordinate system.');
#340=NRF_ENUMERATION_ITEM('planet_centric_inertial_equatorial','An inertial right-handed coordinate system with its origin at the centre of the governing planet with the +Z axis along the planet''s celestial North pole direction and the +X axis in the plane formed by the +Z axis and the vector from the planet''s centre along a specified tas_standard_direction_in_space. The +Y axis completes the right-handed coordinate system.');
#341=NRF_ENUMERATION_ITEM('planet_centric_star_fixed_ecliptic','A right-handed coordinate system with its origin at the centre of the governing planet with the +Z axis normal to the ecliptica in the North direction and the +X axis in the plane formed by the +Z axis and the vector from the planet''s centre to the star''s centre. The +Y axis completes the right-handed coordinate system.');
#342=NRF_ENUMERATION_ITEM('planet_centric_local','A right-handed coordinate system with its origin at the centre of the governing planet with the +Z axis along the planet''s celestial North pole direction and the +X axis in the equatorial plane through zero longitude. This coordinate system is fixed with respect to the planet. The +Y axis completes the right-handed coordinate system.');
