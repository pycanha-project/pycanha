    bisecting = FALSE,
    focus_point = [0.0, 0.0, 0.0],
    initial_angle = 30.0,
    rotation_rate = 6.0,
    stop_point_eclipse = FALSE);

GEOMETRY SOLO;
SOLO = SINGLE_COMBINATION(geometry = PT_TRIANGLE);

FEATURES_TAS = STATIC_ASM + KINEMATIC_ASM + SOLO + 
    ATTRS + SPLIT_DELTA + AUTO_NUM + MOVED + 
    CLEARED + DROPPED_ATTRS + INSULATED + LATE_CONE;

